      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_netstat_Tcp_CurrEstab",
          "legendFormat": "ESTABLISHED",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
