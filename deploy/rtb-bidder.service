[Unit]
Description=RTB lab bidder (mini real-time bidding service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rtb
Group=rtb
WorkingDirectory=/opt/rtb-bidder
Environment=BIDDER_PORT=8080
Environment=BIDDER_CAMPAIGNS=2000
# JVM：固定堆大小、打开 GC 日志（以后排查 GC 停顿要用）
Environment="JAVA_OPTS=-Xms512m -Xmx512m -XX:+UseG1GC -XX:UseSVE=0 -Xlog:gc*:file=/var/log/rtb-bidder/gc.log:time,uptime:filecount=5,filesize=10m"
ExecStart=/bin/sh -c 'exec /usr/bin/java $JAVA_OPTS -cp /opt/rtb-bidder/classes Bidder'
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
